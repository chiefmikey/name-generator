{
  "name": "name-generator",
  "version": "3.0.0",
  "type": "module",
  "description": "Fun social media name generator — pick your birthday, animal, and fruit to generate a unique name",
  "scripts": {
    "build:dev": "NODE_ENV=development webpack --mode development -w",
    "build:prod": "NODE_ENV=production webpack --mode production",
    "dev": "webpack serve --mode development --open",
    "fix": "eslint --fix '**/*'",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "posthog-js": "^1.433.5",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-typescript": "^8.0.1",
    "@mikey-pro/eslint-config-vue": "^10.3.3",
    "@types/webpack": "^5.28.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/babel-plugin-jsx": "^2.0.1",
    "@vue/compiler-sfc": "^3.5.28",
    "@vue/test-utils": "^2.5.1",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.5",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "happy-dom": "^20.14.0",
    "mikey-pro": "^10.3.3",
    "prettier": "^3.9.8",
    "sass": "^1.104.1",
    "sass-loader": "^17.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "vue-loader": "^17.4.2",
    "vue-style-loader": "^4.1.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^5.2.4"
  },
  "homepage": "https://github.com/chiefmikey/name-generator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chiefmikey/name-generator.git"
  },
  "bugs": {
    "url": "https://github.com/chiefmikey/name-generator/issues"
  },
